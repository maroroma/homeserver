<?xml version="1.0" encoding="UTF-8"?>

<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<formats>
		<format>tar.gz</format>
	</formats>

	<id>home-music-player-${project.version}</id>
	<includeBaseDirectory>false</includeBaseDirectory>


	<files>
		<!-- inclusion du fichier de properties -->
		<file>
			<source>${basedir}/src/packaging/application-prod.properties</source>
			<outputDirectory>/config/</outputDirectory>
			<lineEnding>unix</lineEnding>
			<destName>application-prod.properties</destName>
			<filtered>true</filtered>
		</file>
		<!-- inclusion du jar principal -->
		<file>
			<source>${project.build.directory}/home-music-player-${project.version}.jar
			</source>
			<filtered>false</filtered>
			<outputDirectory>/</outputDirectory>
		</file>

		<!-- inclusion du script de lancement linux -->
		<file>
			<source>${basedir}/src/packaging/run.sh</source>
			<filtered>true</filtered>
			<fileMode>775</fileMode>
			<outputDirectory>/</outputDirectory>
		</file>

		<!-- inclusion du script d'installation linux -->
		<file>
			<source>${basedir}/src/packaging/install.sh</source>
			<filtered>true</filtered>
			<fileMode>775</fileMode>
			<outputDirectory>/</outputDirectory>
			<lineEnding>unix</lineEnding>
		</file>
		<!-- inclusion du script de run systemd linux -->
		<file>
			<source>${basedir}/src/packaging/homemusicplayer.service</source>
			<filtered>true</filtered>
			<fileMode>775</fileMode>
			<outputDirectory>/</outputDirectory>
		</file>
	</files>
</assembly>

